/* Configure one GPIO pin as a push-pull output */
static void gpio_output(GPIO_TypeDef *gpio, uint32_t pin) {
    uint32_t shift = pin * 2U;

    // Push-pull output
    gpio->OTYPER &= ~(1U << pin);

    // No pull-up or pull-down
    gpio->PUPDR &= ~(3U << shift);

    // General purpose output (01)
    gpio->MODER &= ~(3U << shift);
    gpio->MODER |=  (1U << shift);
}

/* Configure one GPIO pin as input with pull-up */
static void gpio_input_pullup(GPIO_TypeDef *gpio, uint32_t pin) {
    uint32_t shift = pin * 2U;

    // Input mode (00)
    gpio->MODER &= ~(3U << shift);

    // Enable pull-up (01)
    gpio->PUPDR &= ~(3U << shift);
    gpio->PUPDR |=  (1U << shift);
}

/* Main GPIO initialization */
void gpio_init(void) {
    // 1. Enable GPIO clocks: A, B, F, G, H, I
    RCC->AHB1ENR |= (
        RCC_AHB1ENR_GPIOAEN |
        RCC_AHB1ENR_GPIOBEN |
        RCC_AHB1ENR_GPIOFEN |
        RCC_AHB1ENR_GPIOGEN |
        RCC_AHB1ENR_GPIOHEN |
        RCC_AHB1ENR_GPIOIEN
    );

    // Ensure clock enables have taken effect
    (void)RCC->AHB1ENR;

    // 2. Set initial output levels before enabling output mode
    // Common-anode display:
    // Segments HIGH = off
    // Digit selects LOW = disabled

    GPIOG->BSRR = (1U << 6) | (1U << 7);
    GPIOB->BSRR = (1U << 4) |
                  (1U << (9 + 16)) |
                  (1U << (14 + 16)) |
                  (1U << (15 + 16));

    GPIOH->BSRR = (1U << 6);

    GPIOI->BSRR = (1U << 0) |
                  (1U << 2) |
                  (1U << 3) |
                  (1U << (1 + 16));

    GPIOA->BSRR = (1U << (8 + 16));

    // 3. Configure segment outputs D2-D8
    gpio_output(GPIOG, 6);  // D2
    gpio_output(GPIOB, 4);  // D3
    gpio_output(GPIOG, 7);  // D4
    gpio_output(GPIOI, 0);  // D5
    gpio_output(GPIOH, 6);  // D6
    gpio_output(GPIOI, 3);  // D7
    gpio_output(GPIOI, 2);  // D8

    // 4. Configure digit-select outputs D10-D14
    gpio_output(GPIOA, 8);   // D10
    gpio_output(GPIOB, 15);  // D11
    gpio_output(GPIOB, 14);  // D12
    gpio_output(GPIOI, 1);   // D13
    gpio_output(GPIOB, 9);   // D14

    // 5. Configure switch inputs A0-A3
    gpio_input_pullup(GPIOA, 0);   // A0 - SW0
    gpio_input_pullup(GPIOF, 10);  // A1 - SW1
    gpio_input_pullup(GPIOF, 9);   // A2 - SW2
    gpio_input_pullup(GPIOF, 8);   // A3 - SW3
}








