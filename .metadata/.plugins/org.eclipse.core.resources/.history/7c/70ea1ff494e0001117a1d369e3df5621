#include "main.h"


// Matrix GPIOS

//Columns
#define M_COLUMN_PIN1 15U
#define M_COLUMN_PIN2 14U
#define M_COLUMN_PIN3 9U
#define M_COLUMN_PIN4 8U


// Rows
#define M_ROW_PIN1 7U
#define M_ROW_PIN2 8U
#define M_ROW_PIN3 9U
#define M_ROW_PIN4 10U





void default_matrix_gpios(void) {
	// We only want to turn on clocking once.
	if (!((RCC->AHB1ENR && RCC_AHB1ENR_GPIOBEN)
			|| (RCC->AHB1ENR && RCC_AHB1ENR_GPIOFEN))) {

		//Turn On port clocking
		RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;
		RCC->AHB1ENR |= RCC_AHB1ENR_GPIOFEN;
	}

	//Set the mode of the pins
	//Columns
	GPIOB->MODER &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	//Rows
	GPIOF->MODER |= (
			(1U << (2 * M_ROW_PIN1)) |
			(1U << (2 * M_ROW_PIN2)) |
			(1U << (2 * M_ROW_PIN3)) |
			(1U << (2 * M_ROW_PIN4))
	);

	//Set the output type of the pins
	GPIOB->OTYPER |= (
			(1U << (M_COLUMN_PIN1)) |
			(1U << (M_COLUMN_PIN2)) |
			(1U << (M_COLUMN_PIN3)) |
			(1U << (M_COLUMN_PIN4))
	);

	GPIOF->OTYPER &= ~(
			(1U << (M_ROW_PIN1)) |
			(1U << (M_ROW_PIN2)) |
			(1U << (M_ROW_PIN3)) |
			(1U << (M_ROW_PIN4))
	);

	//Add the pull-up resistors to B
	GPIOB->PUPDR |= (
			(1U << (2 * M_COLUMN_PIN1)) |
			(1U << (2 * M_COLUMN_PIN2)) |
			(1U << (2 * M_COLUMN_PIN3)) |
			(1U << (2 * M_COLUMN_PIN4))
	);

	GPIOF->PUPDR &= ~(
			(3U << (2 * M_ROW_PIN1)) |
			(3U << (2 * M_ROW_PIN2)) |
			(3U << (2 * M_ROW_PIN3)) |
			(3U << (2 * M_ROW_PIN4))
	);

	//Just blanket reseting both doesn't really matter for open drain, it doesn't drive output
	GPIOB->BSRR |= (
			(1U << (M_COLUMN_PIN1 + 16)) |
			(1U << (M_COLUMN_PIN2 + 16)) |
			(1U << (M_COLUMN_PIN3 + 16)) |
			(1U << (M_COLUMN_PIN4 + 16))
	);

	GPIOF->BSRR |= (
			(3U << (M_ROW_PIN1 + 16)) |
			(3U << (M_ROW_PIN2 + 16)) |
			(3U << (M_ROW_PIN3 + 16)) |
			(3U << (M_ROW_PIN4 + 16))
	);
}

void alternate_matrix_gpios(void) {
	// We only want to turn on clocking once.
	if (!((RCC->AHB1ENR && RCC_AHB1ENR_GPIOBEN)
			|| (RCC->AHB1ENR && RCC_AHB1ENR_GPIOFEN))) {

		//Turn On port clocking
		RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;
		RCC->AHB1ENR |= RCC_AHB1ENR_GPIOFEN;
	}

	//Set the mode of the pins
	//Columns
	GPIOB->MODER |= (
			(1U << (2 * M_COLUMN_PIN1)) |
			(1U << (2 * M_COLUMN_PIN2)) |
			(1U << (2 * M_COLUMN_PIN3)) |
			(1U << (2 * M_COLUMN_PIN4))
	);

	//Rows
	GPIOF->MODER &= ~(
			(3U << (2 * M_ROW_PIN1)) |
			(3U << (2 * M_ROW_PIN2)) |
			(3U << (2 * M_ROW_PIN3)) |
			(3U << (2 * M_ROW_PIN4))
	);

	//Set the output type of the pins
	GPIOB->OTYPER &= ~(
			(1U << (M_COLUMN_PIN1)) |
			(1U << (M_COLUMN_PIN2)) |
			(1U << (M_COLUMN_PIN3)) |
			(1U << (M_COLUMN_PIN4))
	);

	GPIOF->OTYPER |= (
			(1U << (M_ROW_PIN1)) |
			(1U << (M_ROW_PIN2)) |
			(1U << (M_ROW_PIN3)) |
			(1U << (M_ROW_PIN4))
	);

	//Add the pull-up resistors to B
	GPIOB->PUPDR &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	GPIOF->PUPDR |= (
			(1U << (2 * M_ROW_PIN1)) |
			(1U << (2 * M_ROW_PIN2)) |
			(1U << (2 * M_ROW_PIN3)) |
			(1U << (2 * M_ROW_PIN4))
	);

	//Just blanket reseting both doesn't really matter for open drain, it doesn't drive output
	GPIOB->BSRR |= (
			(1U << (M_COLUMN_PIN1 + 16)) |
			(1U << (M_COLUMN_PIN2 + 16)) |
			(1U << (M_COLUMN_PIN3 + 16)) |
			(1U << (M_COLUMN_PIN4 + 16))
	);

	GPIOF->BSRR |= (
			(3U << (M_ROW_PIN1 + 16)) |
			(3U << (M_ROW_PIN2 + 16)) |
			(3U << (M_ROW_PIN3 + 16)) |
			(3U << (M_ROW_PIN4 + 16))
	);

}
void configure_matrix_interrupts(void) {


	//Enable clocking
	RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;

	SYSCFG->EXTICR[2] |= (
			(1U << (4 * 0)) | //EXTI 8
			(1U << (4 * 1))   //EXTI 9
	);

	SYSCFG->EXTICR[3] |= (
			(1U << (4 * 2)) | //EXTI 14
			(1U << (4 * 3))   //EXTI 15
	);

	EXTI->IMR &= ~(
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	EXTI->RTSR &= ~(
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	EXTI->FTSR |= (
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	EXTI->PR |= (
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	NVIC_SetPriority(EXTI2_IRQn, 10U);
	NVIC_SetPriority(EXTI3_IRQn, 10U);

	NVIC_ClearPendingIRQ(EXTI2_IRQn);
	NVIC_ClearPendingIRQ(EXTI3_IRQn);

	NVIC_EnableIRQ(EXTI2_IRQn);
	NVIC_EnableIRQ(EXTI3_IRQn);

	EXTI->IMR |= (
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	__enable_irq();


}

void keypad_interrupt_handler(void) {

	uint8_t column = 0;
	uint8_t row = 0;


	if ((GPIOB->IDR &
			(1 << M_COLUMN_PIN1)) == 0 ) {
		//pass

	} else if ((GPIOB->IDR &
			(1 << M_COLUMN_PIN2)) == 0 ) {
		column = 1;

	} else if ((GPIOB->IDR &
			(1 << M_COLUMN_PIN3)) == 0 ) {
		column = 2;

	} else if ((GPIOB->IDR &
			(1 << M_COLUMN_PIN4)) == 0 ) {
		column = 3;

	} else {
		//we are in an error state
		return ;
	}

	alternate_matrix_gpios();

	if ((GPIOF->IDR &
				(1 << M_ROW_PIN1)) == 0 ) {
			//pass

		} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN2)) == 0 ) {
			row = 1;

		} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN3)) == 0 ) {
			row = 2;

		} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN4)) == 0 ) {
			row = 3;

		} else {
			//we are in an error state
			return ;
		}

	default_matrix_gpios();




}


void EXTI2_IRQHandler(void) {
	if (
			(EXTI->PR & ((1 << M_COLUMN_PIN3) | (1 << M_COLUMN_PIN4))) != 0U
	) {

		keypad_interrupt_handler();


		EXTI->PR |= (
				(M_COLUMN_PIN3) | (M_COLUMN_PIN4)
		);
	}

}

void EXTI3_IRQHandler(void) {
	if (
			(EXTI->PR & ((1 << M_COLUMN_PIN1) | (1 << M_COLUMN_PIN2))) != 0U
	) {

		keypad_interrupt_handler();

		EXTI->PR |= (
				(M_COLUMN_PIN1) | (M_COLUMN_PIN2)
		);


	}

}


