#include "main.h"


// Matrix GPIOS

// Columns - GPIOI
#define M_COLUMN_PIN1 0U
#define M_COLUMN_PIN2 1U
#define M_COLUMN_PIN3 2U
#define M_COLUMN_PIN4 3U

// Rows - GPIOF
#define M_ROW_PIN1 7U
#define M_ROW_PIN2 8U
#define M_ROW_PIN3 9U
#define M_ROW_PIN4 10U






void default_matrix_gpios(void) {

	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOIEN;
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOFEN;

	//Set the mode of the pins
	//Columns
	GPIOI->MODER &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	GPIOF->MODER &= ~(
			(3U << (2 * M_ROW_PIN1)) |
			(3U << (2 * M_ROW_PIN2)) |
			(3U << (2 * M_ROW_PIN3)) |
			(3U << (2 * M_ROW_PIN4))
	);

	//Rows
	GPIOF->MODER |= (
			(1U << (2 * M_ROW_PIN1)) |
			(1U << (2 * M_ROW_PIN2)) |
			(1U << (2 * M_ROW_PIN3)) |
			(1U << (2 * M_ROW_PIN4))
	);

	//Set the output type of the pins
	GPIOI->OTYPER &= ~(
			(3U << (M_COLUMN_PIN1)) |
			(3U << (M_COLUMN_PIN2)) |
			(3U << (M_COLUMN_PIN3)) |
			(3U << (M_COLUMN_PIN4))
	);

	GPIOI->OTYPER |= (
			(1U << (M_COLUMN_PIN1)) |
			(1U << (M_COLUMN_PIN2)) |
			(1U << (M_COLUMN_PIN3)) |
			(1U << (M_COLUMN_PIN4))
	);

	GPIOF->OTYPER &= ~(
			(1U << (M_ROW_PIN1)) |
			(1U << (M_ROW_PIN2)) |
			(1U << (M_ROW_PIN3)) |
			(1U << (M_ROW_PIN4))
	);

	//Add the pull-up resistors to B
	GPIOI->PUPDR &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	GPIOI->PUPDR |= (
			(1U << (2 * M_COLUMN_PIN1)) |
			(1U << (2 * M_COLUMN_PIN2)) |
			(1U << (2 * M_COLUMN_PIN3)) |
			(1U << (2 * M_COLUMN_PIN4))
	);

	GPIOF->PUPDR &= ~(
			(3U << (2 * M_ROW_PIN1)) |
			(3U << (2 * M_ROW_PIN2)) |
			(3U << (2 * M_ROW_PIN3)) |
			(3U << (2 * M_ROW_PIN4))
	);

	//Just blanket reseting both doesn't really matter for open drain, it doesn't drive output
	GPIOI->BSRR = 0x000F0000U;
	GPIOF->BSRR = 0x07800000U;
}

void alternate_matrix_gpios(uint8_t col) {

	//Set the mode of the pins
	//Columns
	GPIOI->MODER &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	GPIOI->MODER |= (
			(1U << (2 * M_COLUMN_PIN1)) |
			(1U << (2 * M_COLUMN_PIN2)) |
			(1U << (2 * M_COLUMN_PIN3)) |
			(1U << (2 * M_COLUMN_PIN4))
	);

	//Rows
	GPIOF->MODER &= ~(
			(3U << (2 * M_ROW_PIN1)) |
			(3U << (2 * M_ROW_PIN2)) |
			(3U << (2 * M_ROW_PIN3)) |
			(3U << (2 * M_ROW_PIN4))
	);

	//Set the output type of the pins
	GPIOI->OTYPER &= ~(
			(1U << (M_COLUMN_PIN1)) |
			(1U << (M_COLUMN_PIN2)) |
			(1U << (M_COLUMN_PIN3)) |
			(1U << (M_COLUMN_PIN4))
	);

	GPIOF->OTYPER &= ~(
			(3U << (M_ROW_PIN1)) |
			(3U << (M_ROW_PIN2)) |
			(3U << (M_ROW_PIN3)) |
			(3U << (M_ROW_PIN4))
	);

	GPIOF->OTYPER |= (
			(1U << (M_ROW_PIN1)) |
			(1U << (M_ROW_PIN2)) |
			(1U << (M_ROW_PIN3)) |
			(1U << (M_ROW_PIN4))
	);

	//Add the pull-up resistors to B
	GPIOI->PUPDR &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	GPIOF->PUPDR &= ~(
			(3U << (2 * M_ROW_PIN1)) |
			(3U << (2 * M_ROW_PIN2)) |
			(3U << (2 * M_ROW_PIN3)) |
			(3U << (2 * M_ROW_PIN4))
	);

	GPIOF->PUPDR |= (
			(1U << (2 * M_ROW_PIN1)) |
			(1U << (2 * M_ROW_PIN2)) |
			(1U << (2 * M_ROW_PIN3)) |
			(1U << (2 * M_ROW_PIN4))
	);

	//Just blanket reseting both doesn't really matter for open drain, it doesn't drive output
	GPIOI->BSRR = 0x000F0000U;
	GPIOF->BSRR = 0x07800000U;


}
void configure_matrix_interrupts(void) {


	//Enable clocking
	RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;

	//Port I for our interrupts.
	SYSCFG->EXTICR[0] = 0x8888U;


	EXTI->IMR &= ~(0xFU);

	EXTI->RTSR &= ~(0xFU);
	EXTI->FTSR |= 0xFU;

	EXTI->PR = 0xFU;

	NVIC_SetPriority(EXTI0_IRQn, 10U);
	NVIC_SetPriority(EXTI1_IRQn, 10U);
	NVIC_SetPriority(EXTI2_IRQn, 10U);
	NVIC_SetPriority(EXTI3_IRQn, 10U);

	NVIC_ClearPendingIRQ(EXTI0_IRQn);
	NVIC_ClearPendingIRQ(EXTI1_IRQn);
	NVIC_ClearPendingIRQ(EXTI2_IRQn);
	NVIC_ClearPendingIRQ(EXTI3_IRQn);

	NVIC_EnableIRQ(EXTI0_IRQn);
	NVIC_EnableIRQ(EXTI1_IRQn);
	NVIC_EnableIRQ(EXTI2_IRQn);
	NVIC_EnableIRQ(EXTI3_IRQn);

	EXTI->IMR |= 0xFU;

	__enable_irq();


}

void keypad_interrupt_handler(uint8_t col) {

	uint8_t column = col;
	uint8_t row = 0;


	alternate_matrix_gpios();

	if ((GPIOF->IDR &
				(1 << M_ROW_PIN1)) == 0 ) {
			//pass

	} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN2)) == 0 ) {
		row = 1;

	} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN3)) == 0 ) {
		row = 2;

	} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN4)) == 0 ) {
		row = 3;

	}

	default_matrix_gpios();




}
void EXTI0_IRQHandler(void) {
	if (
			(EXTI->PR & (1 << M_COLUMN_PIN1)) != 0U
	) {

		keypad_interrupt_handler(M_COLUMN_PIN1);


		EXTI->PR |= (1U << M_COLUMN_PIN1);
	}

}

void EXTI1_IRQHandler(void) {
	if (
			(EXTI->PR & (1 << M_COLUMN_PIN2)) != 0U
	) {

		keypad_interrupt_handler(M_COLUMN_PIN2);

		EXTI->PR = 0xFU;

	}

}

void EXTI2_IRQHandler(void) {
	if (
			(EXTI->PR & (1 << M_COLUMN_PIN3)) != 0U
	) {

		keypad_interrupt_handler(M_COLUMN_PIN3);

		EXTI->PR = 0xFU;	}

}

void EXTI3_IRQHandler(void) {
	if (
			(EXTI->PR & (1 << M_COLUMN_PIN4)) != 0U
	) {

		keypad_interrupt_handler(M_COLUMN_PIN4);

		EXTI->PR = 0xFU;
	}

}


