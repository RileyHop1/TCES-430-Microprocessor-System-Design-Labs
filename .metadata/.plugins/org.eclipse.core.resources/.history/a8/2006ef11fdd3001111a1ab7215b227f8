.syntax unified
.cpu cortex-m7
.thumb


.equ RCC_BASE,     0x40023800
.equ RCC_AHB1ENR,  0x30
.equ GPIO_MODER,   0x00
.equ GPIO_ODR,     0x14



.section .data
.align 2

.global ARRAY_POSITIVE
.global ARRAY_NEGATIVE

ARRAY_POSITIVE:
    .word 45, -12, 87, -34, 16
    .word -98, 120, 53, -7, 64

ARRAY_NEGATIVE:
    .word -45, -12, -87, -34, -16
    .word -98, -120, -53, -7, -64

.section .text
.global part1
.align 2

.thumb_func

part1:

	PUSH {R4, R5, R6, LR}

	LDR R1, [R0] //Base address of the positive array.
	LDR R1, [R0] //initalize R1 to 0. LARGEST
	MOVS R2, #1 //Loop initeration.
	MOVS R3, #4
	MOVS R6, #10

	PART1_LOOP:

	CMP R2, R6
	BGE PART1_LOOP_END

	MUL R4, R2, R3
	ADD R4, R4, R0
	LDR R5,[R4] //Current value

	CMP R5, R1

	BLT PART1_ASSIGN_SKIP
		MOV R1, R5
	PART1_ASSIGN_SKIP:

	ADDS R2, R2, #1

	B PART1_LOOP
	PART1_LOOP_END:

	MOV R0, R1
	POP {R4, R5, R6, PC}


