#include "main.h"


// Matrix GPIOS

//Columns
#define M_COLUMN_PIN1 U15
#define M_COLUMN_PIN2 U14
#define M_COLUMN_PIN3 U9
#define M_COLUMN_PIN4 U8


// Rows
#define M_ROW_PIN1 U7
#define M_ROW_PIN2 U8
#define M_ROW_PIN3 U9
#define M_ROW_PIN4 U10





int default_matrix_gpios() {
	// We only want to turn on clocking once.
	if (~((RCC->AHB1ENR && RCC_AHB1ENER_GPIOB)
			|| (RCC->AHB1ENR && RCC_AHB1ENER_GPIOF))) {

		//Turn On port clocking
		RCC->AHB1ENR |= RCC_AHB1ENER_GPIOB;
		RCC->AHB1ENR |= RCC_AHB1ENER_GPIOF;
	}

	//Set the mode of the pins
	//Columns
	GPIOB->MODER &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	//Rows
	GPIOF->MODER |= (
			(1U << (2 * M_ROW_PIN1)) |
			(1U << (2 * M_ROW_PIN2)) |
			(1U << (2 * M_ROW_PIN3)) |
			(1U << (2 * M_ROW_PIN4))
	);

	//Set the output type of the pins
	GPIOB->OTYPER |= (0xFU << (M_COLUMN_PIN1));

	GPIOG->OTYPER &= ~(0xFU << (M_ROW_PIN1));





}

