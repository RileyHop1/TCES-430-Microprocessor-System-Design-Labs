#include "main.h"

#define LED1 3
#define LED2 4
#define LED3 7




void setup_leds(void) {

	//Enable clocking.
	 RCC->AHB1ENR |= (
	        RCC_AHB1ENR_GPIOBEN |
	        RCC_AHB1ENR_GPIOGEN |
	        RCC_AHB1ENR_GPIOIEN
	    );

	 //Set the mode of the pins
	 GPIOI->MODER |= (1U << (LED1 * 2));
	 GPIOB->MODER |= (1U << (LED2 * 2));
	 GPIOG->MODER |= (1U << (LED3 * 2));

	 //Set output type
	 GPIOI->OTYPER &= ~(1U << (LED1));
	 GPIOB->OTYPER &= ~(1U << (LED2));
	 GPIOG->OTYPER &= ~(1U << (LED3));

	 //Set up pull-up resistors
	 GPIOI->OTYPER &= ~(1U << (LED1 * 2));
	 GPIOB->OTYPER &= ~(1U << (LED2 * 2));
	 GPIOG->OTYPER &= ~(1U << (LED3 * 2));




}

