#include "main.h"


// Matrix GPIOS

//Columns
#define M_COLUMN_PIN1 15U
#define M_COLUMN_PIN2 14U
#define M_COLUMN_PIN3 9U
#define M_COLUMN_PIN4 8U


// Rows
#define M_ROW_PIN1 7U
#define M_ROW_PIN2 8U
#define M_ROW_PIN3 9U
#define M_ROW_PIN4 10U





int default_matrix_gpios() {
	// We only want to turn on clocking once.
	if (~((RCC->AHB1ENR && RCC_AHB1ENR_GPIOBEN)
			|| (RCC->AHB1ENR && RCC_AHB1ENR_GPIOFEN))) {

		//Turn On port clocking
		RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;
		RCC->AHB1ENR |= RCC_AHB1ENR_GPIOFEN;
	}

	//Set the mode of the pins
	//Columns
	GPIOB->MODER &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	//Rows
	GPIOF->MODER |= (
			(1U << (2 * M_ROW_PIN1)) |
			(1U << (2 * M_ROW_PIN2)) |
			(1U << (2 * M_ROW_PIN3)) |
			(1U << (2 * M_ROW_PIN4))
	);

	//Set the output type of the pins
	GPIOB->OTYPER |= (
			(1U << (M_COLUMN_PIN1)) |
			(1U << (M_COLUMN_PIN2)) |
			(1U << (M_COLUMN_PIN3)) |
			(1U << (M_COLUMN_PIN4))
	);

	GPIOF->OTYPER &= ~(
			(1U << (M_ROW_PIN1)) |
			(1U << (M_ROW_PIN2)) |
			(1U << (M_ROW_PIN3)) |
			(1U << (M_ROW_PIN4))
	);

	//Add the pull-up resistors to B
	GPIOB->PUPDR |= (
			(1U << (2 * M_COLUMN_PIN1)) |
			(1U << (2 * M_COLUMN_PIN2)) |
			(1U << (2 * M_COLUMN_PIN3)) |
			(1U << (2 * M_COLUMN_PIN4))
	);

	GPIOF->PUPDR &= ~(
			(3U << (2 * M_ROW_PIN1)) |
			(3U << (2 * M_ROW_PIN2)) |
			(3U << (2 * M_ROW_PIN3)) |
			(3U << (2 * M_ROW_PIN4))
	);

	//Just blanket reseting both doesn't really matter for open drain, it doesn't drive output
	GPIOB->BSRR |= (
			(1U << (M_COLUMN_PIN1 + 16)) |
			(1U << (M_COLUMN_PIN2 + 16)) |
			(1U << (M_COLUMN_PIN3 + 16)) |
			(1U << (M_COLUMN_PIN4 + 16))
	);

	GPIOF->BSRR |= (
			(3U << (M_ROW_PIN1 + 16)) |
			(3U << (M_ROW_PIN2 + 16)) |
			(3U << (M_ROW_PIN3 + 16)) |
			(3U << (M_ROW_PIN4 + 16))
	);
}

