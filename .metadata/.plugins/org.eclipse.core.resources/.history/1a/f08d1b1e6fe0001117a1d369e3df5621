int configure_matrix_interrupts() {

	//Enable clocking
	RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;

	SYSCFG->EXTICR[2] |= (
			(1U << (4 * 0)) | //EXTI 8
			(1U << (4 * 1))   //EXTI 9
	);

	SYSCFG->EXTICR[3] |= (
			(1U << (4 * 2)) | //EXTI 14
			(1U << (4 * 3))   //EXTI 15
	);

	EXTI->IMR &= ~(
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	EXTI->RTSR &= ~(
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	EXTI->FTSR |= (
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	EXTI->PR |= (
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	NVIC_SetPriority(EXTI2_IRQn, 10U);
	NVIC_SetPriority(EXTI3_IRQn, 10U);

	NVIC_ClearPending(EXTI2_IRQn);
	NVIC_ClearPending(EXTI3_IRQn);

	NVIC_EnableIRQ(EXTI2_IRQn);
	NVIC_EnableIRQ(EXTI3_IRQn);







}


