#include "main.h"


// Matrix GPIOS

//Columns
#define M_COLUMN_PIN1 15U
#define M_COLUMN_PIN2 14U
#define M_COLUMN_PIN3 9U
#define M_COLUMN_PIN4 8U


// Rows
#define M_ROW_PIN1 7U
#define M_ROW_PIN2 8U
#define M_ROW_PIN3 9U
#define M_ROW_PIN4 10U





void default_matrix_gpios(void) {
	// We only want to turn on clocking once.
	if (!((RCC->AHB1ENR && RCC_AHB1ENR_GPIOBEN)
			|| (RCC->AHB1ENR && RCC_AHB1ENR_GPIOFEN))) {

		//Turn On port clocking
		RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;
		RCC->AHB1ENR |= RCC_AHB1ENR_GPIOFEN;
	}

	//Set the mode of the pins
	//Columns
	GPIOB->MODER &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	//Rows
	GPIOF->MODER |= (
			(1U << (2 * M_ROW_PIN1)) |
			(1U << (2 * M_ROW_PIN2)) |
			(1U << (2 * M_ROW_PIN3)) |
			(1U << (2 * M_ROW_PIN4))
	);

	//Set the output type of the pins
	GPIOB->OTYPER |= (
			(1U << (M_COLUMN_PIN1)) |
			(1U << (M_COLUMN_PIN2)) |
			(1U << (M_COLUMN_PIN3)) |
			(1U << (M_COLUMN_PIN4))
	);

	GPIOF->OTYPER &= ~(
			(1U << (M_ROW_PIN1)) |
			(1U << (M_ROW_PIN2)) |
			(1U << (M_ROW_PIN3)) |
			(1U << (M_ROW_PIN4))
	);

	//Add the pull-up resistors to B
	GPIOB->PUPDR |= (
			(1U << (2 * M_COLUMN_PIN1)) |
			(1U << (2 * M_COLUMN_PIN2)) |
			(1U << (2 * M_COLUMN_PIN3)) |
			(1U << (2 * M_COLUMN_PIN4))
	);

	GPIOF->PUPDR &= ~(
			(3U << (2 * M_ROW_PIN1)) |
			(3U << (2 * M_ROW_PIN2)) |
			(3U << (2 * M_ROW_PIN3)) |
			(3U << (2 * M_ROW_PIN4))
	);

	//Just blanket reseting both doesn't really matter for open drain, it doesn't drive output
	GPIOB->BSRR |= (
			(1U << (M_COLUMN_PIN1 + 16)) |
			(1U << (M_COLUMN_PIN2 + 16)) |
			(1U << (M_COLUMN_PIN3 + 16)) |
			(1U << (M_COLUMN_PIN4 + 16))
	);

	GPIOF->BSRR |= (
			(3U << (M_ROW_PIN1 + 16)) |
			(3U << (M_ROW_PIN2 + 16)) |
			(3U << (M_ROW_PIN3 + 16)) |
			(3U << (M_ROW_PIN4 + 16))
	);
}

void alternate_matrix_gpios(void) {
	// We only want to turn on clocking once.
	if (!((RCC->AHB1ENR && RCC_AHB1ENR_GPIOBEN)
			|| (RCC->AHB1ENR && RCC_AHB1ENR_GPIOFEN))) {

		//Turn On port clocking
		RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN;
		RCC->AHB1ENR |= RCC_AHB1ENR_GPIOFEN;
	}

	//Set the mode of the pins
	//Columns
	GPIOB->MODER |= (
			(1U << (2 * M_COLUMN_PIN1)) |
			(1U << (2 * M_COLUMN_PIN2)) |
			(1U << (2 * M_COLUMN_PIN3)) |
			(1U << (2 * M_COLUMN_PIN4))
	);

	//Rows
	GPIOF->MODER &= ~(
			(3U << (2 * M_ROW_PIN1)) |
			(3U << (2 * M_ROW_PIN2)) |
			(3U << (2 * M_ROW_PIN3)) |
			(3U << (2 * M_ROW_PIN4))
	);

	//Set the output type of the pins
	GPIOB->OTYPER &= ~(
			(1U << (M_COLUMN_PIN1)) |
			(1U << (M_COLUMN_PIN2)) |
			(1U << (M_COLUMN_PIN3)) |
			(1U << (M_COLUMN_PIN4))
	);

	GPIOF->OTYPER |= (
			(1U << (M_ROW_PIN1)) |
			(1U << (M_ROW_PIN2)) |
			(1U << (M_ROW_PIN3)) |
			(1U << (M_ROW_PIN4))
	);

	//Add the pull-up resistors to B
	GPIOB->PUPDR &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	GPIOF->PUPDR |= (
			(1U << (2 * M_ROW_PIN1)) |
			(1U << (2 * M_ROW_PIN2)) |
			(1U << (2 * M_ROW_PIN3)) |
			(1U << (2 * M_ROW_PIN4))
	);

	//Just blanket reseting both doesn't really matter for open drain, it doesn't drive output
	GPIOB->BSRR |= (
			(1U << (M_COLUMN_PIN1 + 16)) |
			(1U << (M_COLUMN_PIN2 + 16)) |
			(1U << (M_COLUMN_PIN3 + 16)) |
			(1U << (M_COLUMN_PIN4 + 16))
	);

	GPIOF->BSRR |= (
			(3U << (M_ROW_PIN1 + 16)) |
			(3U << (M_ROW_PIN2 + 16)) |
			(3U << (M_ROW_PIN3 + 16)) |
			(3U << (M_ROW_PIN4 + 16))
	);

}
void configure_matrix_interrupts(void) {


	//Enable clocking
	RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;

	SYSCFG->EXTICR[2] |= (
			(1U << (4 * 0)) | //EXTI 8
			(1U << (4 * 1))   //EXTI 9
	);

	SYSCFG->EXTICR[3] |= (
			(1U << (4 * 2)) | //EXTI 14
			(1U << (4 * 3))   //EXTI 15
	);

	EXTI->IMR &= ~(
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	EXTI->RTSR &= ~(
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	EXTI->FTSR |= (
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	EXTI->PR |= (
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	NVIC_SetPriority(EXTI2_IRQn, 10U);
	NVIC_SetPriority(EXTI3_IRQn, 10U);

	NVIC_ClearPendingIRQ(EXTI2_IRQn);
	NVIC_ClearPendingIRQ(EXTI3_IRQn);

	NVIC_EnableIRQ(EXTI2_IRQn);
	NVIC_EnableIRQ(EXTI3_IRQn);

	EXTI->IMR |= (
			(M_COLUMN_PIN1) |
			(M_COLUMN_PIN2) |
			(M_COLUMN_PIN3) |
			(M_COLUMN_PIN4)
	);

	__enable_irq();


}

void keypad_interrupt_handler(void) {

	uint8_t column = 0;
	uint8_t row = 0;


	if ((GPIOB->IDR &
			(1 << M_COLUMN_PIN1)) == 0 ) {
		//pass

	} else if ((GPIOB->IDR &
			(1 << M_COLUMN_PIN2)) == 0 ) {
		column = 1;

	} else if ((GPIOB->IDR &
			(1 << M_COLUMN_PIN3)) == 0 ) {
		column = 2;

	} else if ((GPIOB->IDR &
			(1 << M_COLUMN_PIN4)) == 0 ) {
		column = 3;

	} else {
		//we are in an error state
		return ;
	}

	alternate_matrix_gpios();

	if ((GPIOF->IDR &
				(1 << M_ROW_PIN1)) == 0 ) {
			//pass

		} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN2)) == 0 ) {
			row = 1;

		} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN3)) == 0 ) {
			row = 2;

		} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN4)) == 0 ) {
			row = 3;

		} else {
			//we are in an error state
			return ;
		}

	default_matrix_gpios();




}


void EXTI2_IRQHandler(void) {
	if (
			(EXTI->PR & ((1 << M_COLUMN_PIN3) | (1 << M_COLUMN_PIN4))) != 0U
	) {

		keypad_interrupt_handler();


		EXTI->PR |= (
				(M_COLUMN_PIN3) | (M_COLUMN_PIN4)
		);
	}

}

void EXTI3_IRQHandler(void) {
	if (
			(EXTI->PR & ((1 << M_COLUMN_PIN1) | (1 << M_COLUMN_PIN2))) != 0U
	) {

		keypad_interrupt_handler();

		EXTI->PR |= (
				(M_COLUMN_PIN1) | (M_COLUMN_PIN2)
		);


	}

}




int main(void) {


    // 1. CLOCK ENABLES

    // ------------------------------------------------------------

    // Bit 8 = GPIOI (LED1 & Switch), Bit 1 = GPIOB (New Timer LED2)

    RCC->AHB1ENR |= (1UL << 8) | (1UL << 1);

    // Bit 0 enables TIM2 clock on the APB1 bus

    RCC->APB1ENR |= (1UL << 0);

    // ------------------------------------------------------------

    // 2. GPIO CONFIGURATION

    // ------------------------------------------------------------

    // LED 1 (PI3) -> Output

    GPIOI->MODER  &= ~(3UL << (3 * 2));

    GPIOI->MODER  |=  (1UL << (3 * 2));

    GPIOI->OTYPER &= ~(1UL << 3);

    // Switch (PI2) -> Input with Pull-up

    GPIOI->MODER  &= ~(3UL << (2 * 2));

    GPIOI->PUPDR  &= ~(3UL << (2 * 2));

    GPIOI->PUPDR  |=  (1UL << (2 * 2));

    // LED 2 (PB4) -> Output (Controlled by Timer)

    // Clear bits 8 & 9 (4 * 2 = 8)

    GPIOB->MODER  &= ~(3UL << (4 * 2));

    // Set to Output mode (01)

    GPIOB->MODER  |=  (1UL << (4 * 2));

    // Set to Push-Pull (0)

    GPIOB->OTYPER &= ~(1UL << 4);

    // ------------------------------------------------------------

    // 3. TIMER 2 CONFIGURATION (~500ms toggle rate on 16MHz default clock)

    // ------------------------------------------------------------

    TIM2->PSC = 15999;       // Divide 16 MHz clock by 16000 = 1000 Hz ticks

    TIM2->ARR = 500;         // Reset every 500 ticks (500 ms)

    TIM2->SR &= ~(1UL << 0);  // Clear the initial Update Interrupt Flag (UIF)

    TIM2->CR1 |= (1UL << 0);  // Enable Counter (CEN bit)

    uint8_t led2_state = 0;

    **while** (1) {

        // ------------------------------------------------------------

        // MAIN LOOP STEP A: Switch controlling LED 1 (Instant polling)

        // ------------------------------------------------------------

        **if** ((GPIOI->IDR & (1UL << 2)) == 0) {

            GPIOI->BSRR = (1UL << 3);         // Switch pressed -> LED 1 ON

        } **else** {

            GPIOI->BSRR = (1UL << (3 + 16));   // Switch released -> LED 1 OFF

        }

        // ------------------------------------------------------------

        // MAIN LOOP STEP B: Timer checking for LED 2 (PB4)

        // ------------------------------------------------------------

        // Check if the Update Interrupt Flag (UIF, Bit 0) is tripped

        **if** (TIM2->SR & (1UL << 0)) {

            TIM2->SR &= ~(1UL << 0);          // Clear update flag manually

            **if** (led2_state == 0) {

                GPIOB->BSRR = (1UL << 4);       // Turn PB4 ON

                led2_state = 1;

            } **else** {

                GPIOB->BSRR = (1UL << (4 + 16)); // Turn PB4 OFF

                led2_state = 0;

            }

        }

    }

}

