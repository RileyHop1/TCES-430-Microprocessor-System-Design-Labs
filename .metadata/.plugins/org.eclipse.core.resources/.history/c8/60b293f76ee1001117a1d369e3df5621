    if (key >= '0' && key <= '9' && pin_index < 4U) {
    	//Reset the pins index
    	if (pin_index > 4) {
    		//Reset pin
    		entered_pin[0] = 0;
    		entered_pin[1] = 0;
    		entered_pin[2] = 0;
    	 	entered_pin[3] = 0;
    	   	pin_index = 0;
    	  	//clear the LCD
    	}

    	entered_pin[pin_index] = key;
    	pin_index++;



