
.syntax unified
.cpu cortex-m7
.thumb


.section .text
.global part1
.align 2
.thumb_func

part2:
	PUSH {R4, R5, R6, R7, LR}
	MOVS R1, #1 	//i
	MOVS R2, #0 	//j
	LDR R3, =-1 	//k
	MOVS R4, #2 	//a
	MOVS R5, #1 	//b


	WHILE_START:
		CMP R1, R2
		BLE WHILE_END

		ADD R1, R1 ,R4
		MOVS R7, #2
		MUL R6, R2, R7
		SUB R1, R1, R6

		CMP R2, R3
		BLT IF_END
		IF_START:
			ADDS R1, #2
			SUB R3, R3, R5

			ADD R3, R3, R6

		IF_END:

		ADDS R2, #1
		B WHILE_START
	WHILE_END:

    POP {R4, R5, R6, R7, PC}

PART2_END:

