#include "main.h"

#define LED1 3
#define LED2 4
#define LED3 7

#define DB4 0
#define DB5 10
#define DB6 9
#define DB6 8





void setup_leds(void) {

	//Enable clocking.
	 RCC->AHB1ENR |= (
	        RCC_AHB1ENR_GPIOBEN |
	        RCC_AHB1ENR_GPIOGEN |
	        RCC_AHB1ENR_GPIOIEN
	    );

	 //Set the mode of the pins
	 GPIOI->MODER |= (1U << (LED1 * 2));
	 GPIOB->MODER |= (1U << (LED2 * 2));
	 GPIOG->MODER |= (1U << (LED3 * 2));

	 //Set output type
	 GPIOI->OTYPER &= ~(1U << (LED1));
	 GPIOB->OTYPER &= ~(1U << (LED2));
	 GPIOG->OTYPER &= ~(1U << (LED3));

	 //Set up pull-up resistors
	 GPIOI->PUPDR |= (1U << (LED1 * 2));
	 GPIOB->PUPDR |= (1U << (LED2 * 2));
	 GPIOG->PUPDR |= (1U << (LED3 * 2));




}

void setup_lcd_data_bus(void) {

	//Enable clocking.
		 RCC->AHB1ENR |= (
		        RCC_AHB1ENR_GPIOAEN |
		        RCC_AHB1ENR_GPIOFEN
		    );

		 //Set the mode of the pins
		 GPIOI->MODER |= (1U << (DB4 * 2));
		 GPIOB->MODER |= (1U << (DB5 * 2));
		 GPIOG->MODER |= (1U << (DB6 * 2));
		 GPIOG->MODER |= (1U << (DB7 * 2));



}

