    {GPIOI, 0}, // D 3
    {GPIOH, 6}, // E 4
    {GPIOI, 3}, // F 5
    {GPIOI, 2}  // G 6
};

/* Lights up the segment in question*/
void edit_display(const SegmentPin* segment, uint8_t clear) {


	if (clear == 1) {
		segment->port->BSRR = (1UL << (segment->pin)); //sets the pin
	} else {
		segment->port->BSRR = (1UL << (segment->pin + 16U)); //resets the pin

	}

}
