void simpleDelay(uint32_t count) {
	while (count--) {
		__asm__("NOP");
	}
}


int main(void) {


	//Enable clocking for GPIOF
	RCC->AHB1ENR |= (1<<5UL);

	//Reset all moder pins
	GPIOF->MODER &= ~(0xFF<<(3*2));

	//Set pins 3-5 to 11 for general in
	GPIOF->MODER |= (0x3F<<(3*2));

	//Set pin 6 to general out
	GPIOF->MODER |= (0b01<<(6*2));

	//Set pins 3-6 to push pull
	GPIOF->OTYPER |= (0xFF<<3);

	//Set pin 6 to pull-down
	GPIOF->PUPDR |= (0b10<<(6*2));

	while(1) {
		simpleDelay(1000000);

	}









	return 0;
}
