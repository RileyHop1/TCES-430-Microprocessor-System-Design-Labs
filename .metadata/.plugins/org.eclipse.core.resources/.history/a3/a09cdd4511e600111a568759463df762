/*
 * Lab 6 Node A: standalone keypad test for STM32F746G-DISCO.
 * Use as Core/Src/main.c in a copy of the bare-metal Lab 5 project.
 * Columns C1-C4: PI0, PI1, PI2, PI3 (D5, D13, D8, D7).
 * Rows R1-R4: PB8, PB9, PB14, PB15 (D15, D14, D12, D11).
 * Optional external green LED: PG7 (D4), through 330 ohms to GND.
 * Watch last_key, submitted_pin and submission_count in the debugger.
 * TIM2 assumes its input clock is 16 MHz, as in Lab 5.
 */

#include "main.h"

#define M_COLUMN_PIN1  0U
#define M_COLUMN_PIN2  1U
#define M_COLUMN_PIN3  2U
#define M_COLUMN_PIN4  3U
// KEYPAD PINS - ROWS: GPIOB, avoiding the LCD's PF6-PF10
// PB8=D15, PB9=D14, PB14=D12, PB15=D11 (Arduino header)
#define M_ROW_PIN1     8U
#define M_ROW_PIN2     9U
#define M_ROW_PIN3    14U
#define M_ROW_PIN4    15U
#define COLUMN_MASK  0x000FU
#define ROW_MASK     0xC300U  // PB8, PB9, PB14, PB15
#define ROW_MODE_MASK ( \
    (3U << (2U * M_ROW_PIN1)) | \
    (3U << (2U * M_ROW_PIN2)) | \
    (3U << (2U * M_ROW_PIN3)) | \
    (3U << (2U * M_ROW_PIN4)) )
#define ROW_OUTPUT_MODE ( \
    (1U << (2U * M_ROW_PIN1)) | \
    (1U << (2U * M_ROW_PIN2)) | \
    (1U << (2U * M_ROW_PIN3)) | \
    (1U << (2U * M_ROW_PIN4)) )

#define PIN_LENGTH 4U
#define RELEASE_DEBOUNCE_MS 20U
#define LED_PIN 7U
#define LED_PULSE_MS 100U

static volatile uint8_t key_ready;
static volatile uint8_t keypad_locked;
static volatile char last_key;

// These retain the last complete PIN and the total submissions for debugging.
volatile char submitted_pin[PIN_LENGTH + 1U];
volatile uint32_t submission_count;

static const char key_table[4][4] = {
    {'1', '2', '3', 'A'},
    {'4', '5', '6', 'B'},
    {'7', '8', '9', 'C'},
    {'*', '0', '#', 'D'}
};
static char entered_pin[PIN_LENGTH];
static uint8_t pin_index;
static uint8_t release_started;
static uint32_t release_time;
static uint8_t led_active;
static uint32_t led_start_ms;

static void default_matrix_gpios(void) {
    // GPIOB row output latches LOW, GPIOI column latches LOW.
    GPIOB->BSRR = ROW_MASK << 16U;
    GPIOI->BSRR = COLUMN_MASK << 16U;
    GPIOB->OTYPER &= ~ROW_MASK;
    GPIOB->MODER =
        (GPIOB->MODER & ~ROW_MODE_MASK) | ROW_OUTPUT_MODE;
    GPIOB->PUPDR &= ~ROW_MODE_MASK;
    // Restore columns to pull-up inputs after rows become LOW outputs.
    GPIOI->OTYPER &= ~COLUMN_MASK;
    GPIOI->PUPDR =
        (GPIOI->PUPDR & ~0xFFU) | 0x55U;
    GPIOI->MODER &= ~0xFFU;
}

static void alternate_matrix_gpios(uint8_t col) {
    // Protect against an invalid column index.
    if (col > 3U) {
        return;
    }
    // Enable row pull-ups BEFORE switching them into input mode.
    GPIOB->PUPDR =
        (GPIOB->PUPDR & ~ROW_MODE_MASK) | ROW_OUTPUT_MODE;
    GPIOB->MODER &= ~ROW_MODE_MASK;
    // Only the EXTI-triggering column is driven LOW.
    GPIOI->BSRR = (1U << (col + 16U));
    GPIOI->OTYPER &= ~(1U << col);
    GPIOI->PUPDR &= ~(3U << (2U * col));
    GPIOI->MODER =
        (GPIOI->MODER & ~(3U << (2U * col))) |
        (1U << (2U * col));
}

static void configure_matrix_interrupts(void) {
    // EXTI0-3 are sourced from port I (port selector 8).
    SYSCFG->EXTICR[0] = (SYSCFG->EXTICR[0] & ~0xFFFFU) | 0x8888U;
    EXTI->IMR &= ~COLUMN_MASK;
    EXTI->RTSR &= ~COLUMN_MASK;
    EXTI->FTSR |= COLUMN_MASK;
    EXTI->PR = COLUMN_MASK;
    NVIC_SetPriority(EXTI0_IRQn, 10U);
    NVIC_SetPriority(EXTI1_IRQn, 10U);
    NVIC_SetPriority(EXTI2_IRQn, 10U);
    NVIC_SetPriority(EXTI3_IRQn, 10U);
    NVIC_ClearPendingIRQ(EXTI0_IRQn);
    NVIC_ClearPendingIRQ(EXTI1_IRQn);
    NVIC_ClearPendingIRQ(EXTI2_IRQn);
    NVIC_ClearPendingIRQ(EXTI3_IRQn);
    NVIC_EnableIRQ(EXTI0_IRQn);
    NVIC_EnableIRQ(EXTI1_IRQn);
    NVIC_EnableIRQ(EXTI2_IRQn);
    NVIC_EnableIRQ(EXTI3_IRQn);
    EXTI->IMR |= COLUMN_MASK;
    __enable_irq();
}

static void configure_timer(void) {
    RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;
    (void)RCC->APB1ENR;
    TIM2->CR1 &= ~TIM_CR1_CEN;

    // Assumes TIM2's input clock is 16 MHz.
    // 16,000,000 / (15999 + 1) = 1000 counter ticks per second.
    TIM2->PSC = 15999U;
    TIM2->ARR = 0xFFFFFFFFU;
    TIM2->EGR = TIM_EGR_UG;  // Load the new prescaler.
    TIM2->CNT = 0U;
    TIM2->SR = 0U;
    TIM2->CR1 |= TIM_CR1_CEN;
}

static void keypad_interrupt_handler(uint8_t col) {
    if (keypad_locked) {
        return;
    }
    keypad_locked = 1U;
    EXTI->IMR &= ~COLUMN_MASK;
    uint8_t row = 10U;  // Invalid row until a LOW input is found.
    alternate_matrix_gpios(col);
    // Short settle delay (not the 20 ms mechanical debounce interval).
    for (volatile uint32_t i = 0U; i < 300U; ++i) {
        __NOP();
    }
    uint32_t row_states = GPIOB->IDR;
    if ((row_states & (1U << M_ROW_PIN1)) == 0U) {
        row = 0U;
    } else if ((row_states & (1U << M_ROW_PIN2)) == 0U) {
        row = 1U;
    } else if ((row_states & (1U << M_ROW_PIN3)) == 0U) {
        row = 2U;
    } else if ((row_states & (1U << M_ROW_PIN4)) == 0U) {
        row = 3U;
    }
    default_matrix_gpios();
    if (row == 10U) {
        return;  // The main loop will rearm EXTI after a stable release.
    }
    last_key = key_table[row][col];
    key_ready = 1U;
}

void EXTI0_IRQHandler(void) {
    if (EXTI->PR & (1U << M_COLUMN_PIN1)) {
        keypad_interrupt_handler(M_COLUMN_PIN1);
        EXTI->PR = (1U << M_COLUMN_PIN1);
    }
}

void EXTI1_IRQHandler(void) {
    if (EXTI->PR & (1U << M_COLUMN_PIN2)) {
        keypad_interrupt_handler(M_COLUMN_PIN2);
        EXTI->PR = (1U << M_COLUMN_PIN2);
    }
}

void EXTI2_IRQHandler(void) {
    if (EXTI->PR & (1U << M_COLUMN_PIN3)) {
        keypad_interrupt_handler(M_COLUMN_PIN3);
        EXTI->PR = (1U << M_COLUMN_PIN3);
    }
}

void EXTI3_IRQHandler(void) {
    if (EXTI->PR & (1U << M_COLUMN_PIN4)) {
        keypad_interrupt_handler(M_COLUMN_PIN4);
        EXTI->PR = (1U << M_COLUMN_PIN4);
    }
}

static void setup_feedback_led(void) {
    GPIOG->BSRR = 1U << (LED_PIN + 16U);
    GPIOG->OTYPER &= ~(1U << LED_PIN);
    GPIOG->PUPDR &= ~(3U << (2U * LED_PIN));
    GPIOG->MODER =
        (GPIOG->MODER & ~(3U << (2U * LED_PIN))) | (1U << (2U * LED_PIN));
}

static void handle_key(char key, uint32_t now_ms) {
    GPIOG->BSRR = 1U << LED_PIN;
    led_start_ms = now_ms;
    led_active = 1U;

    if (key < '0' || key > '9') {
        return;
    }

    entered_pin[pin_index++] = key;
    if (pin_index == PIN_LENGTH) {
        for (uint8_t i = 0U; i < PIN_LENGTH; ++i) {
            submitted_pin[i] = entered_pin[i];
        }
        submitted_pin[PIN_LENGTH] = '\0';
        ++submission_count;
        pin_index = 0U;
    }
}

static void update_release_debounce(uint32_t now_ms) {
    if (!keypad_locked) {
        return;
    }

    if ((GPIOI->IDR & COLUMN_MASK) != COLUMN_MASK) {
        release_started = 0U;
        return;
    }

    if (!release_started) {
        release_started = 1U;
        release_time = now_ms;
        return;
    }

    if ((uint32_t)(now_ms - release_time) < RELEASE_DEBOUNCE_MS) {
        return;
    }

    // Clear edges from the scan and contact bounce before arming EXTI again.
    EXTI->PR = COLUMN_MASK;
    release_started = 0U;
    if ((GPIOI->IDR & COLUMN_MASK) == COLUMN_MASK) {
        keypad_locked = 0U;
        EXTI->IMR |= COLUMN_MASK;
    }
}

int main(void) {

}


int node_a_init(void) {
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOBEN |
                    RCC_AHB1ENR_GPIOGEN |
                    RCC_AHB1ENR_GPIOIEN;
    RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;
    (void)RCC->AHB1ENR;
    (void)RCC->APB2ENR;

    setup_feedback_led();
    default_matrix_gpios();
    configure_timer();
    configure_matrix_interrupts();

    return 0;

}

int node_a_step(void) {

	uint32_t now_ms = TIM2->CNT;
    if (key_ready) {
    	char key = last_key;
        key_ready = 0U;
        handle_key(key, now_ms);
    }

    update_release_debounce(now_ms);
    if (led_active && (uint32_t)(now_ms - led_start_ms) >= LED_PULSE_MS) {
    	GPIOG->BSRR = 1U << (LED_PIN + 16U);
        led_active = 0U;
    }

    return 0;
}
