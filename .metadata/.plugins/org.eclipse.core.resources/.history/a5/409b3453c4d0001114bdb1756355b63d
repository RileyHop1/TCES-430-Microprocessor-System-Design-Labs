}

void EXTI1_IRQHandler(void) {
	if (EXTI->PR & (1U << 1)) {

		EXTI->PR = (1U << 1);

	}
}

void EXTI2_IRQHandler(void) {
	if (EXTI->PR & (1U << 2)) {

		EXTI->PR = (1U << 2);

	}

}

int main(void) {

	setup_leds();
	setup_lcd_data_bus();
	setup_switches();
	setup_tim2();

	uint8_t led2_toggle_count = 0;
	uint8_t led3_toggle_count = 0;

	while(1) {
	    if (TIM2->SR & TIM_SR_UIF) {
	        TIM2->SR &= ~TIM_SR_UIF;

	        if (led2_toggle_count < 10) {
	        	if (GPIOB->ODR & (1U << LED2))
	        		GPIOB->BSRR = (1U << (LED2 + 16));

	        	else GPIOB->BSRR = (1U << LED2);

	        	led2_toggle_count++;
	        } else if (led3_toggle_count < 16) {
	        	if (GPIOG->ODR & (1U << LED3))
	        		GPIOG->BSRR = (1U << (LED3 + 16));

	        	else GPIOG->BSRR = (1U << LED3);

	        	led3_toggle_count++;
	        } else {
	        	led2_toggle_count = 0;
	        	led3_toggle_count = 0;
	        }
	    }


	}

	return 0;
}
