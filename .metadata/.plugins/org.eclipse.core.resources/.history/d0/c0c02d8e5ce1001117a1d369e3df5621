#include "main.h"


// Matrix GPIOS

// Columns - GPIOI
#define M_COLUMN_PIN1 0U
#define M_COLUMN_PIN2 1U
#define M_COLUMN_PIN3 2U
#define M_COLUMN_PIN4 3U

// Rows - GPIOF
#define M_ROW_PIN1 7U
#define M_ROW_PIN2 8U
#define M_ROW_PIN3 9U
#define M_ROW_PIN4 10U


volatile uint8_t last_row = 10;
volatile uint8_t last_col = 10;


// This is probably right double check
static const char key_table[4][4] = {
		{'1','2','3','A'},
		{'4','5','6','B'},
		{'7','8','9','C'},
		{'*','0','#','D'}
};




void default_matrix_gpios(void) {


	//Just blanket reseting both doesn't really matter for open drain, it doesn't drive output
	GPIOI->BSRR = 0x000F0000U;
	GPIOF->BSRR = 0x07800000U;

	//Set the mode of the pins

	//Rows
	GPIOF->MODER &= ~(
	    (3U << (2 * M_ROW_PIN1)) |
	    (3U << (2 * M_ROW_PIN2)) |
	    (3U << (2 * M_ROW_PIN3)) |
	    (3U << (2 * M_ROW_PIN4))
	);

	GPIOF->MODER |= (
	    (1U << (2 * M_ROW_PIN1)) |
	    (1U << (2 * M_ROW_PIN2)) |
	    (1U << (2 * M_ROW_PIN3)) |
	    (1U << (2 * M_ROW_PIN4))
	);

	//Columns
	GPIOI->MODER &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	//Set the output type of the pins
	GPIOI->OTYPER &= ~(
			(1U << (M_COLUMN_PIN1)) |
			(1U << (M_COLUMN_PIN2)) |
			(1U << (M_COLUMN_PIN3)) |
			(1U << (M_COLUMN_PIN4))
	);

	GPIOF->OTYPER &= ~(
			(1U << (M_ROW_PIN1)) |
			(1U << (M_ROW_PIN2)) |
			(1U << (M_ROW_PIN3)) |
			(1U << (M_ROW_PIN4))
	);

	//Add the pull-up resistors to B
	GPIOI->PUPDR &= ~(
			(3U << (2 * M_COLUMN_PIN1)) |
			(3U << (2 * M_COLUMN_PIN2)) |
			(3U << (2 * M_COLUMN_PIN3)) |
			(3U << (2 * M_COLUMN_PIN4))
	);

	GPIOI->PUPDR |= (
			(1U << (2 * M_COLUMN_PIN1)) |
			(1U << (2 * M_COLUMN_PIN2)) |
			(1U << (2 * M_COLUMN_PIN3)) |
			(1U << (2 * M_COLUMN_PIN4))
	);

	GPIOF->PUPDR &= ~(
			(3U << (2 * M_ROW_PIN1)) |
			(3U << (2 * M_ROW_PIN2)) |
			(3U << (2 * M_ROW_PIN3)) |
			(3U << (2 * M_ROW_PIN4))
	);

}


void alternate_matrix_gpios(uint8_t col) {

    // Enable pull-ups on all four rows
    GPIOF->PUPDR &= ~(
        (3U << (2 * M_ROW_PIN1)) |
        (3U << (2 * M_ROW_PIN2)) |
        (3U << (2 * M_ROW_PIN3)) |
        (3U << (2 * M_ROW_PIN4))
    );

    GPIOF->PUPDR |= (
        (1U << (2 * M_ROW_PIN1)) |
        (1U << (2 * M_ROW_PIN2)) |
        (1U << (2 * M_ROW_PIN3)) |
        (1U << (2 * M_ROW_PIN4))
    );

    // Change rows to inputs
    GPIOF->MODER &= ~(
        (3U << (2 * M_ROW_PIN1)) |
        (3U << (2 * M_ROW_PIN2)) |
        (3U << (2 * M_ROW_PIN3)) |
        (3U << (2 * M_ROW_PIN4))
    );

    // Preload selected column LOW
    GPIOI->BSRR = (1U << (col + 16U));

    // Select push-pull and disable pull-up
    GPIOI->OTYPER &= ~(1U << col);
    GPIOI->PUPDR &= ~(3U << (2U * col));

    // Change selected column to output
    GPIOI->MODER &= ~(3U << (2U * col));
    GPIOI->MODER |=  (1U << (2U * col));
}

void configure_matrix_interrupts(void) {



	//Port I for our interrupts.
	SYSCFG->EXTICR[0] = 0x8888U;


	EXTI->IMR &= ~(0xFU);

	EXTI->RTSR &= ~(0xFU);
	EXTI->FTSR |= 0xFU;

	EXTI->PR = 0xFU;

	NVIC_SetPriority(EXTI0_IRQn, 10U);
	NVIC_SetPriority(EXTI1_IRQn, 10U);
	NVIC_SetPriority(EXTI2_IRQn, 10U);
	NVIC_SetPriority(EXTI3_IRQn, 10U);

	NVIC_ClearPendingIRQ(EXTI0_IRQn);
	NVIC_ClearPendingIRQ(EXTI1_IRQn);
	NVIC_ClearPendingIRQ(EXTI2_IRQn);
	NVIC_ClearPendingIRQ(EXTI3_IRQn);

	NVIC_EnableIRQ(EXTI0_IRQn);
	NVIC_EnableIRQ(EXTI1_IRQn);
	NVIC_EnableIRQ(EXTI2_IRQn);
	NVIC_EnableIRQ(EXTI3_IRQn);

	EXTI->IMR |= 0xFU;

	__enable_irq();


}

void keypad_interrupt_handler(uint8_t col) {

	uint8_t row = 10;//invalid row


	alternate_matrix_gpios(col);

	for (volatile uint32_t i = 0; i < 300U; i++) {
	    __NOP();
	}

	//Only doing the first encountered key is fine for me.
	if ((GPIOF->IDR &
				(1 << M_ROW_PIN1)) == 0 ) {
			row = 0;

	} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN2)) == 0 ) {
		row = 1;

	} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN3)) == 0 ) {
		row = 2;
	} else if ((GPIOF->IDR &
				(1 << M_ROW_PIN4)) == 0 ) {
		row = 3;

	}


	default_matrix_gpios();


	if (row == 10) {
		//error state
		return ;

	}


	char key = key_table[row][col];






}
void EXTI0_IRQHandler(void) {
	if (
			(EXTI->PR & (1 << M_COLUMN_PIN1)) != 0U
	) {

		keypad_interrupt_handler(M_COLUMN_PIN1);


		EXTI->PR = (1U << M_COLUMN_PIN1);
	}

}

void EXTI1_IRQHandler(void) {
	if (
			(EXTI->PR & (1 << M_COLUMN_PIN2)) != 0U
	) {

		keypad_interrupt_handler(M_COLUMN_PIN2);

		EXTI->PR = (1U << M_COLUMN_PIN2);
	}

}

void EXTI2_IRQHandler(void) {
	if (
			(EXTI->PR & (1 << M_COLUMN_PIN3)) != 0U
	) {

		keypad_interrupt_handler(M_COLUMN_PIN3);

		EXTI->PR = (1U << M_COLUMN_PIN3);
	}

}

void EXTI3_IRQHandler(void) {
	if (
			(EXTI->PR & (1 << M_COLUMN_PIN4)) != 0U
	) {

		keypad_interrupt_handler(M_COLUMN_PIN4);

		EXTI->PR = (1U << M_COLUMN_PIN4);

	}

}


int main(void) {

	//Enable clocking
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOIEN;
	RCC->AHB1ENR |= RCC_AHB1ENR_GPIOFEN;
	RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;

    default_matrix_gpios();
    configure_matrix_interrupts();

    while (1) {
        __NOP();
    }

    return 0;
}
